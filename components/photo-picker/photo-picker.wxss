/* 照片选择面板 */
.picker {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}
.mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--color-mask);
}
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}
.tabs {
  display: flex;
  gap: 16rpx;
}
.tab {
  padding: 10rpx 28rpx;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  color: var(--color-text-2);
  border: 2rpx solid var(--color-line);
}
.tab.active {
  color: var(--color-on-brand);
  background: var(--color-brand);
  border-color: var(--color-brand);
}
.close {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 48rpx;
  color: var(--color-text-2);
}

.body {
  flex: 1;
  height: 0;
}
.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--color-text-2);
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 0 32rpx 32rpx;
}
.cell {
  position: relative;
  padding-top: 100%;
  border-radius: var(--radius-btn);
  overflow: hidden;
  background: var(--color-placeholder);
  box-sizing: border-box;
}
.thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
/* 当前照片框中的照片：高亮边框 */
.cell.current::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border: 6rpx solid var(--color-accent);
  border-radius: var(--radius-btn);
}
.tags {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  max-width: calc(100% - 16rpx);
  padding: 0 10rpx;
  border-radius: 4rpx;
  background: var(--color-scrim);
  color: var(--color-on-scrim);
  font-size: 20rpx;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
