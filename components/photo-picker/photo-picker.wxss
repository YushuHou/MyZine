/* 照片选择面板 */
.picker {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}
.mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  display: flex;
  flex-direction: column;
  background: #F6F4EF;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}
.tabs {
  display: flex;
  gap: 16rpx;
}
.tab {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #8A847A;
  background: #FFFFFF;
}
.tab.active {
  color: #FFFFFF;
  background: #2B2B2B;
}
.close {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 48rpx;
  color: #8A847A;
}

.body {
  flex: 1;
  height: 0;
}
.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #8A847A;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 0 32rpx 32rpx;
}
.cell {
  position: relative;
  padding-top: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #E6E1D8;
  box-sizing: border-box;
}
.thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
/* 当前照片框中的照片：高亮边框 */
.cell.current::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border: 6rpx solid #2F80ED;
  border-radius: 12rpx;
}
.tags {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  max-width: calc(100% - 16rpx);
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
