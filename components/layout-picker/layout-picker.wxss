/* 版式选择面板 */
.picker {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}
.mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--color-mask);
}
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 78vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
}
.close {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 48rpx;
  color: var(--color-text-2);
}
.body {
  flex: 1;
  height: 0;
}
.group {
  padding: 0 32rpx 24rpx;
}
.group-title {
  margin: 8rpx 0 16rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
}
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.card {
  padding: 16rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  border: 4rpx solid transparent;
}
/* 当前版式：柯达黄边框 */
.card.current {
  border-color: var(--color-accent);
}

/* 示意图：外框 3:2，两页各 3:4 */
.spread {
  position: relative;
  width: 100%;
  padding-top: 66.67%;
  display: flex;
}
.page {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  background: var(--color-bg);
}
.page:first-child {
  left: 0;
  box-shadow: inset -2rpx 0 0 var(--color-line);
}
.page:last-child {
  right: 0;
}
.page.full {
  left: 0;
  width: 100%;
  box-shadow: none;
}
.frame {
  position: absolute;
  background: var(--color-text-3);
}
.name {
  margin-top: 12rpx;
  font-size: 24rpx;
  text-align: center;
  color: var(--color-text);
}

/* 照片形状 */
.frame.circle,
.frame.ellipse {
  border-radius: 50%;
}
.frame.arch {
  border-radius: 999rpx 999rpx 0 0;
}
.frame.rounded {
  border-radius: 8%;
}
