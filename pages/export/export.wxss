/** 导出 **/
/* 常驻提示：相册不会保存 */
.save-note {
  margin-bottom: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-on-accent);
  background: var(--color-accent);
  border-radius: var(--radius-btn);
}

.page {
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
}
.card-title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

/* 清晰度选项 */
.option {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-btn);
}
.option.active {
  border-color: var(--color-brand);
}
.radio {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin: 4rpx 20rpx 0 0;
  border: 2rpx solid var(--color-text-3);
  border-radius: 50%;
  box-sizing: border-box;
}
.option.active .radio {
  border: 10rpx solid var(--color-brand);
}
.option-name {
  font-size: 30rpx;
}
.option-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}

.block-btn {
  width: 100% !important;
  margin: 24rpx 0 0 !important;
}

/* 生成结果 */
.result {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--color-line);
}
.result-title {
  font-size: 30rpx;
  font-weight: 600;
}
.result-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
  word-break: break-all;
}
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.half-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
}

/* 图片模式 */
.modes {
  display: flex;
  gap: 16rpx;
}
.mode {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  border-radius: var(--radius-btn);
  border: 2rpx solid var(--color-line);
  color: var(--color-text-2);
}
.mode.active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: var(--color-on-brand);
}
.hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}

/* 页选择 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}
.chip {
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  border-radius: var(--radius-btn);
  border: 2rpx solid var(--color-line);
  color: var(--color-text);
}
/* 选中的页：柯达黄 */
.chip.selected {
  border-color: var(--color-accent);
  background: var(--color-accent);
  color: var(--color-on-accent);
}
.select-all {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-brand);
}

/* 进度 */
.progress-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-mask);
}
.progress-card {
  width: 560rpx;
  padding: 40rpx 36rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
}
.progress-text {
  text-align: center;
  font-size: 30rpx;
}
.progress-bar {
  height: 12rpx;
  margin-top: 28rpx;
  border-radius: var(--radius-btn);
  background: var(--color-line);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--color-brand);
  transition: width 0.2s;
}
.progress-cancel {
  margin-top: 24rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-2);
}
