/** 导出 **/
/* 常驻提示：相册不会保存 */
.save-note {
  margin-bottom: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8A6D3B;
  background: #FBF3E3;
  border-radius: 12rpx;
}

.page {
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.card-title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

/* 清晰度选项 */
.option {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #EEE9E0;
  border-radius: 16rpx;
}
.option.active {
  border-color: #B5835A;
  background: #FBF7F2;
}
.radio {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin: 4rpx 20rpx 0 0;
  border: 2rpx solid #C9C1B3;
  border-radius: 50%;
  box-sizing: border-box;
}
.option.active .radio {
  border: 10rpx solid #B5835A;
}
.option-name {
  font-size: 30rpx;
}
.option-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A847A;
}

.block-btn {
  width: 100% !important;
  margin: 24rpx 0 0 !important;
}

/* 生成结果 */
.result {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #EEE9E0;
}
.result-title {
  font-size: 30rpx;
  font-weight: 600;
}
.result-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A847A;
  word-break: break-all;
}
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.half-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
}

/* 图片模式 */
.modes {
  display: flex;
  gap: 16rpx;
}
.mode {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: #F6F4EF;
  color: #8A847A;
}
.mode.active {
  background: #2B2B2B;
  color: #FFFFFF;
}
.hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8A847A;
}

/* 页选择 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}
.chip {
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  border-radius: 10rpx;
  border: 2rpx solid #EEE9E0;
  color: #2B2B2B;
}
.chip.selected {
  border-color: #B5835A;
  background: #B5835A;
  color: #FFFFFF;
}
.select-all {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #B5835A;
}

/* 进度 */
.progress-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}
.progress-card {
  width: 560rpx;
  padding: 40rpx 36rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.progress-text {
  text-align: center;
  font-size: 30rpx;
}
.progress-bar {
  height: 12rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #EEE9E0;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #B5835A;
  transition: width 0.2s;
}
.progress-cancel {
  margin-top: 24rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8A847A;
}
