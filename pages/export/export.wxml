<!-- 导出 -->
<view class="page">
  <view class="save-note">相册只保存在本次使用中，关闭小程序后不会保留，请及时导出</view>
  <!-- PDF 相册 -->
  <view class="card">
    <view class="card-title">导出 PDF 相册</view>
    <view class="option {{preset === 'share' ? 'active' : ''}}" data-preset="share" bindtap="onPreset">
      <view class="radio"></view>
      <view class="option-main">
        <view class="option-name">分享版</view>
        <view class="option-desc">每页 1080×1440，约 0.3MB/页，适合手机查看和转发</view>
      </view>
    </view>
    <view class="option {{preset === 'print' ? 'active' : ''}}" data-preset="print" bindtap="onPreset">
      <view class="radio"></view>
      <view class="option-main">
        <view class="option-name">打印版</view>
        <view class="option-desc">每页 2480×3307（约 300dpi，21×28cm），约 1.5MB/页，适合打印冲印</view>
      </view>
    </view>
    <button class="btn-primary block-btn" bindtap="onGeneratePdf">生成 PDF</button>

    <view wx:if="{{pdf}}" class="result">
      <view class="result-title">已生成：{{pdf.pages}} 页，{{pdf.sizeText}}</view>
      <view class="result-name">{{pdf.fileName}} · {{pdf.preset === 'print' ? '打印版' : '分享版'}}</view>
      <view class="result-actions">
        <button class="btn-primary half-btn" bindtap="onSharePdf">发送到聊天</button>
        <button class="btn-secondary half-btn" bindtap="onOpenPdf">打开预览</button>
      </view>
    </view>
  </view>

  <!-- 保存图片 -->
  <view class="card">
    <view class="card-title">保存为图片</view>
    <view class="modes">
      <view class="mode {{imageMode === 'page' ? 'active' : ''}}" data-mode="page" bindtap="onImageMode">单页 1080×1440</view>
      <view class="mode {{imageMode === 'spread' ? 'active' : ''}}" data-mode="spread" bindtap="onImageMode">跨页 2160×1440</view>
    </view>
    <view wx:if="{{imageMode === 'spread'}}" class="hint">封面、封底按单页保存</view>
    <view class="chips">
      <view wx:for="{{chips}}" wx:key="key" class="chip {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="onToggleChip">{{item.label}}</view>
    </view>
    <view class="select-all" bindtap="onSelectAll">{{selectedCount < chips.length ? '全选' : '全不选'}}</view>
    <button class="btn-primary block-btn" disabled="{{!selectedCount}}" bindtap="onSaveImages">保存到相册（{{selectedCount}} 张）</button>
  </view>

  <!-- 进度 -->
  <view wx:if="{{busy}}" class="progress-mask" catchtouchmove="noop">
    <view class="progress-card">
      <view class="progress-text">{{progressText}}</view>
      <view class="progress-bar"><view class="progress-fill" style="width: {{progressPercent}}%;"></view></view>
      <view class="progress-cancel" bindtap="onCancel">取消</view>
    </view>
  </view>
</view>
