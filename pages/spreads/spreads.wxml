<!-- 跨页管理 -->
<wxs src="../../core/ui/sortable.wxs" module="sortable" />
<view class="page">
  <view class="tip">点击跨页回到编辑 · 长按正文跨页拖动排序</view>

  <!-- 封面、扉页：固定 -->
  <view wx:for="{{headItems}}" wx:key="id" class="row" style="height: {{rowH}}px;" data-id="{{item.id}}" bindtap="onOpen">
    <view class="thumb"><image wx:if="{{item.thumb}}" class="thumb-img" src="{{item.thumb}}" mode="aspectFit" /></view>
    <view class="meta">
      <view class="label">{{item.label}}</view>
      <view class="sub">{{item.sub}}</view>
    </view>
    <view class="fixed-tag">固定</view>
  </view>

  <!-- 正文跨页：可拖动排序 -->
  <view class="list" style="height: {{gridHeight}}px;">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="row sortable {{dragIndex === index ? 'dragging' : ''}}"
      style="top: {{item.y}}px; height: {{rowH}}px;"
      data-index="{{index}}"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="{{sortable.longpress}}"
      bindtouchmove="{{sortable.touchmove}}"
      bindtouchend="{{sortable.touchend}}"
      bindtouchcancel="{{sortable.touchend}}"
    >
      <view class="thumb"><image wx:if="{{item.thumb}}" class="thumb-img" src="{{item.thumb}}" mode="aspectFit" /></view>
      <view class="meta">
        <view class="label">{{item.label}}</view>
        <view class="sub">{{item.sub}}</view>
      </view>
      <view class="more" data-id="{{item.id}}" catchtap="onMore">⋯</view>
    </view>
  </view>
  <view wx:if="{{!items.length}}" class="empty">还没有正文跨页，点下方「添加跨页」</view>

  <!-- 封底：固定 -->
  <view wx:for="{{tailItems}}" wx:key="id" class="row" style="height: {{rowH}}px;" data-id="{{item.id}}" bindtap="onOpen">
    <view class="thumb"><image wx:if="{{item.thumb}}" class="thumb-img" src="{{item.thumb}}" mode="aspectFit" /></view>
    <view class="meta">
      <view class="label">{{item.label}}</view>
      <view class="sub">{{item.sub}}</view>
    </view>
    <view class="fixed-tag">固定</view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="onAdd">添加跨页</button>
  </view>
</view>
