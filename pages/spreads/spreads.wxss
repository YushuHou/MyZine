/** 跨页管理 **/
.page {
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
}
.tip {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #8A847A;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* 正文跨页：绝对定位，拖动时其余行平滑让位 */
.list {
  position: relative;
  margin-bottom: 16rpx;
}
.row.sortable {
  position: absolute;
  left: 0;
  right: 0;
  margin-bottom: 0;
  transition: top 0.2s;
}
.row.dragging {
  z-index: 10;
  transition: none;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2);
}

/* 缩略图 3:2 */
.thumb {
  flex-shrink: 0;
  width: 240rpx;
  height: 160rpx;
  background: #EEE9E0;
  border-radius: 6rpx;
  overflow: hidden;
}
.thumb-img {
  width: 100%;
  height: 100%;
}

.meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.label {
  font-size: 32rpx;
  font-weight: 600;
}
.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A847A;
}
.fixed-tag {
  font-size: 24rpx;
  color: #B9B2A6;
}
.more {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: #8A847A;
}

.empty {
  padding: 40rpx 0 56rpx;
  text-align: center;
  color: #8A847A;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 244, 239, 0.96);
}
.footer button {
  width: 100% !important;
  margin: 0 !important;
}
