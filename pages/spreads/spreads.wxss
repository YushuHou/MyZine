/** 跨页管理 **/
.page {
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
}
.tip {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

/* 正文跨页：绝对定位，拖动时其余行平滑让位 */
.list {
  position: relative;
  margin-bottom: 16rpx;
}
.row.sortable {
  position: absolute;
  left: 0;
  right: 0;
  margin-bottom: 0;
  transition: top 0.2s;
}
.row.dragging {
  z-index: 10;
  transition: none;
  box-shadow: 0 12rpx 32rpx var(--color-shadow);
}

/* 缩略图 3:2 */
.thumb {
  flex-shrink: 0;
  width: 240rpx;
  height: 160rpx;
  /* 上下 6、左右 9：内框保持 3:2，投影和图片边缘对齐 */
  padding: 6rpx 9rpx;
  box-sizing: border-box;
  background: var(--color-desk);
  border-radius: 4rpx;
  overflow: hidden;
}
.thumb-img {
  width: 100%;
  height: 100%;
  box-shadow: var(--shadow-book);
}

.meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
/* 页码标签：柯达黄 */
.label {
  display: inline-block;
  padding: 2rpx 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-btn);
  background: var(--color-accent);
  color: var(--color-on-accent);
}
.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}
.fixed-tag {
  font-size: 24rpx;
  color: var(--color-text-3);
}
.more {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--color-text-2);
}

.empty {
  padding: 40rpx 0 56rpx;
  text-align: center;
  color: var(--color-text-2);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-line);
}
.footer button {
  width: 100% !important;
  margin: 0 !important;
}
