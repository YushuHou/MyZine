/** 立体翻书预览 **/
page {
  height: 100%;
  background: #3A3835;
}
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.book {
  position: relative;
  perspective: 2200px;
  box-shadow: 0 10rpx 48rpx rgba(0, 0, 0, 0.4);
}

/* 左右半页：显示跨页图的一半（图片宽 200%，右半时左移 100%） */
.half {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  overflow: hidden;
}
.half.left {
  left: 0;
}
.half.right {
  left: 50%;
}
.half-img {
  position: absolute;
  top: 0;
  width: 200%;
  height: 100%;
}
.pos-left {
  left: 0;
}
.pos-right {
  left: -100%;
}

.loading {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 26rpx;
}

/* 翻动的书页 */
.leaf {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  z-index: 5;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
}
/* 向后翻：在右半边，绕书脊（左边）翻转 */
.leaf.dir-next {
  left: 50%;
  transform-origin: 0 50%;
}
/* 向前翻：在左半边，绕书脊（右边）翻转 */
.leaf.dir-prev {
  left: 0;
  transform-origin: 100% 50%;
}
.leaf.hidden {
  visibility: hidden;
}
.face {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.face.back {
  transform: rotateY(180deg);
}

/* 书页靠书脊一侧略暗，翻动时更有立体感 */
.shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.shade-next-front,
.shade-prev-back {
  background: linear-gradient(to right, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0) 30%);
}
.shade-next-back,
.shade-prev-front {
  background: linear-gradient(to left, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0) 30%);
}

/* 书脊：中线一道浅阴影 */
.spine {
  position: absolute;
  top: 0;
  left: 50%;
  width: 6%;
  height: 100%;
  margin-left: -3%;
  z-index: 6;
  pointer-events: none;
  background: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.12) 50%, rgba(0, 0, 0, 0));
}

.label {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}
.counter {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}
