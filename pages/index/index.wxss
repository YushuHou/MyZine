/** 首页 **/
.page {
  padding: 24rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
}

.header {
  padding: 16rpx 0 32rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.subtitle {
  margin-top: 8rpx;
  color: var(--color-text-2);
}

/* 书籍信息卡片：靛蓝「书封」 */
.info-card {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 28rpx;
  background: var(--color-brand);
  color: var(--color-on-brand);
  border-radius: var(--radius-card);
}
.info-main {
  flex: 1;
  min-width: 0;
}
.info-title {
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.info-empty {
  font-weight: normal;
}
.info-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-on-brand);
  opacity: 0.7;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.info-arrow {
  margin-left: 16rpx;
  font-size: 44rpx;
  color: var(--color-on-brand);
  opacity: 0.6;
}

/* 空状态 */
.empty {
  margin-top: 0;
  height: 480rpx;
  border: 4rpx dashed var(--color-text-3);
  border-radius: var(--radius-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-2);
}
.empty-plus {
  font-size: 120rpx;
  line-height: 1;
  color: var(--color-brand);
}
.empty-text {
  margin-top: 16rpx;
  font-size: 34rpx;
  color: var(--color-text);
}
.empty-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
}

/* 照片网格 */
.count {
  margin-bottom: 16rpx;
  color: var(--color-text-2);
}
.grid {
  position: relative;
}
/* 每格绝对定位，位置由 JS 计算，拖动排序时其余照片平滑让位 */
.cell {
  position: absolute;
  border-radius: var(--radius-btn);
  overflow: hidden;
  background: var(--color-placeholder);
  transition: left 0.2s, top 0.2s;
}
.cell.dragging {
  z-index: 10;
  transition: none;
  opacity: 0.9;
  box-shadow: 0 12rpx 32rpx var(--color-shadow);
}
.thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.no,
.badge {
  position: absolute;
  left: 8rpx;
  padding: 0 12rpx;
  border-radius: 4rpx;
  background: var(--color-scrim);
  color: var(--color-on-scrim);
  font-size: 22rpx;
  line-height: 36rpx;
}
/* 照片序号：柯达黄标签 */
.no {
  top: 8rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 600;
}
.badge {
  bottom: 8rpx;
}
.remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-on-scrim);
  background: var(--color-scrim);
  border-bottom-left-radius: var(--radius-btn);
}

/* 继续添加格子 */
.add-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  border: 4rpx dashed var(--color-brand);
  box-sizing: border-box;
  color: var(--color-brand);
}
.add-plus {
  font-size: 72rpx;
  line-height: 1;
}
.add-text {
  margin-top: 8rpx;
  font-size: 26rpx;
}

/* 开发工具入口（正式版不显示） */
.dev-links {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
  text-decoration: underline;
}

.dev-sep {
  margin: 0 12rpx;
  text-decoration: none;
}

/* 底部按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-line);
}
.footer-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
}
