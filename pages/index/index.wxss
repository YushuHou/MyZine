/** 首页 **/
.page {
  padding: 24rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
}

.header {
  padding: 16rpx 0 32rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.subtitle {
  margin-top: 8rpx;
  color: #8A847A;
}

/* 书籍信息卡片 */
.info-card {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.info-main {
  flex: 1;
  min-width: 0;
}
.info-title {
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.info-empty {
  font-weight: normal;
}
.info-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8A847A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.info-arrow {
  margin-left: 16rpx;
  font-size: 44rpx;
  color: #C9C1B3;
}

/* 空状态 */
.empty {
  margin-top: 0;
  height: 480rpx;
  border: 4rpx dashed #C9C1B3;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8A847A;
}
.empty-plus {
  font-size: 120rpx;
  line-height: 1;
  color: #B5835A;
}
.empty-text {
  margin-top: 16rpx;
  font-size: 34rpx;
  color: #2B2B2B;
}
.empty-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
}

/* 照片网格 */
.count {
  margin-bottom: 16rpx;
  color: #8A847A;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.cell {
  position: relative;
  padding-top: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #E6E1D8;
}
.thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.no,
.badge {
  position: absolute;
  left: 8rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 36rpx;
}
.no {
  top: 8rpx;
}
.badge {
  bottom: 8rpx;
}
.remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 36rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.45);
  border-bottom-left-radius: 12rpx;
}

/* 继续添加格子 */
.add-cell {
  background: #FFFFFF;
  border: 4rpx dashed #B5835A;
  box-sizing: border-box;
}
.add-inner {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B5835A;
}
.add-plus {
  font-size: 72rpx;
  line-height: 1;
}
.add-text {
  margin-top: 8rpx;
  font-size: 26rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 244, 239, 0.96);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.footer-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
}
