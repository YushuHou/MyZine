/** 编辑页 **/
page {
  height: 100%;
}
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 0 0;
}
.page-canvas {
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.12);
}

.toolbar {
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}
.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.nav {
  margin: 0 !important;
}
.pager-text {
  min-width: 200rpx;
  text-align: center;
}
.pager-count {
  font-size: 24rpx;
  color: #8A847A;
}

/* 固定高度：切换操作栏时画布位置不变 */
.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 88rpx;
  margin-top: 16rpx;
}
.guide-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8A847A;
}
.info-btn {
  width: auto !important;
  margin: 0 !important;
  padding: 0 28rpx !important;
}
.save-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
}

/* 照片框操作按钮 */
.tool {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #2B2B2B;
}
.tool.disabled {
  color: #C9C1B3;
}
.tool-primary {
  background: #2B2B2B;
  color: #FFFFFF;
}
.hint {
  flex: 2;
  font-size: 26rpx;
  color: #8A847A;
}
