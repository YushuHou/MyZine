/** 编辑页 **/
page {
  height: 100%;
}
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 0 0;
}
.page-canvas {
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.12);
}

.toolbar {
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}
.pager {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.nav {
  margin: 0 !important;
}
.pager-text {
  min-width: 200rpx;
  text-align: center;
}

/* 固定高度：切换操作栏时画布位置不变 */
.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 88rpx;
  margin-top: 16rpx;
}
/* 参考线开关：页码行右侧 */
.guide-toggle {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #8A847A;
  border: 1rpx solid #C9C1B3;
}
.guide-toggle.on {
  color: #FFFFFF;
  background: #2F80ED;
  border-color: #2F80ED;
}

/* 照片框操作按钮 */
.tool {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #2B2B2B;
}
.tool.disabled {
  color: #C9C1B3;
}
.tool-primary {
  background: #2B2B2B;
  color: #FFFFFF;
}
.hint {
  flex: 2;
  font-size: 26rpx;
  color: #8A847A;
}
