/** 编辑页 **/
page {
  height: 100%;
}
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 0 0;
}
.page-canvas {
  box-shadow: var(--shadow-book);
}

.toolbar {
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}
.pager {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.nav {
  margin: 0 !important;
  font-size: 26rpx !important;
}
/* 当前页标签：柯达黄 */
.pager-text {
  min-width: 160rpx;
  padding: 6rpx 20rpx;
  text-align: center;
  font-weight: 600;
  border-radius: var(--radius-btn);
  background: var(--color-accent);
  color: var(--color-on-accent);
}

/* 固定高度：切换操作栏时画布位置不变 */
.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 88rpx;
  margin-top: 16rpx;
}
/* 参考线开关：页码行右侧 */
.guide-toggle {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-btn);
  font-size: 22rpx;
  color: var(--color-text-2);
  border: 2rpx solid var(--color-text-3);
}
.guide-toggle.on {
  color: var(--color-on-brand);
  background: var(--color-brand);
  border-color: var(--color-brand);
}

/* 照片框操作按钮 */
.tool {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: var(--radius-btn);
  border: 2rpx solid var(--color-text);
  box-sizing: border-box;
  color: var(--color-text);
}
.tool.disabled {
  color: var(--color-text-3);
  border-color: var(--color-text-3);
}
.tool-primary {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: var(--color-on-brand);
}
.hint {
  flex: 2;
  font-size: 26rpx;
  color: var(--color-text-2);
}

/* 「相册不会保存」提示条：浮在页面顶部，不影响画布位置 */
.save-notice {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 16rpx;
  z-index: 50;
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-surface);
  background: var(--color-text);
  border-radius: var(--radius-card);
  box-shadow: 0 8rpx 24rpx var(--color-shadow);
}
.save-notice-text {
  flex: 1;
}
.save-notice-close {
  margin-left: 16rpx;
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--color-surface);
  opacity: 0.7;
}
