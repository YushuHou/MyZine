/** 编辑页 **/
page {
  height: 100%;
}
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶部栏：参考线开关 + 导出 */
.topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 24rpx;
}
.guide-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-btn);
  opacity: 0.55;
}
.guide-toggle.on {
  background: var(--color-brand);
  opacity: 1;
}
.guide-icon {
  width: 40rpx;
  height: 40rpx;
}
/* 导出：全页唯一的实心按钮 */
.export-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  border-radius: var(--radius-btn);
  background: var(--color-brand);
  color: var(--color-on-brand);
}

/* 画布区：占满剩余高度（画布尺寸按它的实际高度计算） */
.stage {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page-canvas {
  box-shadow: var(--shadow-book);
}

/* 翻页行 */
.pager {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
}
.arrow {
  width: 88rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.arrow.off {
  opacity: 0.25;
}
.arrow-icon {
  width: 40rpx;
  height: 40rpx;
}
.pager-text {
  min-width: 180rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text);
}

/* 页面缩略图条 */
.strip {
  flex-shrink: 0;
  height: 108rpx;
  white-space: nowrap;
}
.strip-inner {
  display: inline-flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 24rpx 0;
}
.strip-item {
  position: relative;
  flex-shrink: 0;
  padding-bottom: 14rpx;
}
/* 缩略图：左右页成对 3:2，封面 / 封底单页 3:4，高度相同 */
.strip-thumb {
  position: relative;
  height: 80rpx;
  overflow: hidden;
  background: var(--color-desk);
  box-shadow: 0 2rpx 6rpx var(--color-shadow);
}
.strip-pair .strip-thumb,
.strip-full .strip-thumb {
  width: 120rpx;
}
.strip-cover .strip-thumb,
.strip-back .strip-thumb {
  width: 60rpx;
}
.strip-img {
  position: absolute;
  top: 0;
  width: 100%;
  height: 100%;
  left: 0;
}
/* 单页只显示跨页图的一半：封面在右半，封底在左半 */
.strip-img-cover,
.strip-img-back {
  width: 200%;
}
.strip-img-cover {
  left: -100%;
}
/* 点击区：左右页成对时分成两半，点哪半跳到哪一页 */
.strip-hits {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
}
.strip-hit {
  flex: 1;
}
/* 当前页：柯达黄下划线（左右页成对时只划在当前那一半下面） */
.strip-line {
  position: absolute;
  bottom: 4rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-accent);
}
.strip-line-left {
  left: 0;
  width: 50%;
}
.strip-line-right {
  left: 50%;
  width: 50%;
}
.strip-line-full,
.strip-line-single {
  left: 0;
  width: 100%;
}

/* 底部标签栏 */
.tabbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--color-line);
}
.tab {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab.off {
  opacity: 0.3;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
}
.tab-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-2);
}
/* 完成：靛蓝图标和文字，比其他项醒目，但不是实心按钮 */
.tab-brand .tab-text {
  color: var(--color-brand);
  font-weight: 600;
}
.tab-hint {
  flex: 2;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-2);
}

/* 「相册不会保存」提示条：浮在页面顶部，不影响画布位置 */
.save-notice {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 16rpx;
  z-index: 50;
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-surface);
  background: var(--color-text);
  border-radius: var(--radius-card);
  box-shadow: 0 8rpx 24rpx var(--color-shadow);
}
.save-notice-text {
  flex: 1;
}
.save-notice-close {
  margin-left: 16rpx;
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--color-surface);
  opacity: 0.7;
}
