/** 编辑页 **/
page {
  height: 100%;
}
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 0 0;
}
.page-canvas {
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.12);
}

.toolbar {
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}
.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.nav {
  margin: 0 !important;
}
.pager-text {
  min-width: 120rpx;
  text-align: center;
  color: #8A847A;
}

.actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
}
.guide-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8A847A;
}
.save-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
}
