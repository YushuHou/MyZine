/** 编辑页 **/
page {
  height: 100%;
}
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶部栏：参考线开关 + 导出 */
.topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 24rpx;
}
.guide-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-btn);
  opacity: 0.55;
}
.guide-toggle.on {
  background: var(--color-brand);
  opacity: 1;
}
.guide-icon {
  width: 40rpx;
  height: 40rpx;
}
/* 导出：全页唯一的实心按钮 */
.export-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  border-radius: var(--radius-btn);
  background: var(--color-brand);
  color: var(--color-on-brand);
}

/* 画布区：占满剩余高度（画布尺寸按它的实际高度计算） */
.stage {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page-canvas {
  box-shadow: var(--shadow-book);
}

/* 翻页行 */
.pager {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
}
.arrow {
  width: 88rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.arrow.off {
  opacity: 0.25;
}
.arrow-icon {
  width: 40rpx;
  height: 40rpx;
}
.pager-text {
  min-width: 180rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text);
}

/* 底部标签栏 */
.tabbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--color-line);
}
.tab {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab.off {
  opacity: 0.3;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
}
.tab-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-2);
}
/* 完成：靛蓝图标和文字，比其他项醒目，但不是实心按钮 */
.tab-brand .tab-text {
  color: var(--color-brand);
  font-weight: 600;
}
.tab-hint {
  flex: 2;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-2);
}

/* 「相册不会保存」提示条：浮在页面顶部，不影响画布位置 */
.save-notice {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 16rpx;
  z-index: 50;
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-surface);
  background: var(--color-text);
  border-radius: var(--radius-card);
  box-shadow: 0 8rpx 24rpx var(--color-shadow);
}
.save-notice-text {
  flex: 1;
}
.save-notice-close {
  margin-left: 16rpx;
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--color-surface);
  opacity: 0.7;
}
