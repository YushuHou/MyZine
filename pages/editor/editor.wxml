<!-- 编辑页：一屏一页 -->
<view class="page">
  <!-- 提示条：每次打开小程序后第一次进入编辑页时显示，5 秒后自动收起 -->
  <view wx:if="{{saveNotice}}" class="save-notice" bindtap="onCloseNotice">
    <text class="save-notice-text">相册只保存在本次使用中，关闭小程序后不会保留，记得及时导出 PDF 或保存图片。</text>
    <text class="save-notice-close">×</text>
  </view>
  <view class="stage" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
    <canvas type="2d" id="pageCanvas" class="page-canvas" style="width: {{canvasW}}px; height: {{canvasH}}px;"></canvas>
  </view>

  <view class="toolbar">
    <view class="pager">
      <button class="nav" size="mini" disabled="{{current <= 0}}" bindtap="onPrev">上一页</button>
      <view class="pager-text">{{label}}</view>
      <button class="nav" size="mini" disabled="{{current >= total - 1}}" bindtap="onNext">下一页</button>
      <view class="guide-toggle {{guides ? 'on' : ''}}" bindtap="onToggleGuides">参考线</view>
    </view>

    <!-- 普通状态 -->
    <view wx:if="{{mode === 'normal'}}" class="actions">
      <view class="tool" bindtap="onEditInfo">书籍信息</view>
      <view class="tool" bindtap="onManageSpreads">管理跨页</view>
      <view class="tool" bindtap="onPreview">预览</view>
      <view class="tool tool-primary" bindtap="onExport">导出</view>
    </view>

    <!-- 选中照片框 -->
    <view wx:elif="{{mode === 'selected'}}" class="actions">
      <view class="tool" bindtap="onChangePhoto">{{hasPhoto ? '换照片' : '选照片'}}</view>
      <view class="tool {{hasPhoto && slotFit === 'fill' ? '' : 'disabled'}}" bindtap="onAdjust">调整</view>
      <view class="tool {{hasPhoto ? '' : 'disabled'}}" bindtap="onToggleFit">{{slotFit === 'fit' ? '填满' : '完整显示'}}</view>
      <view class="tool tool-primary" bindtap="onDeselect">完成</view>
    </view>

    <!-- 调整照片 -->
    <view wx:else class="actions">
      <view class="hint">单指拖动 · 双指缩放</view>
      <view class="tool" bindtap="onResetAdjust">复位</view>
      <view class="tool tool-primary" bindtap="onAdjustDone">完成</view>
    </view>
  </view>

  <photo-picker show="{{pickerShow}}" photos="{{pickerPhotos}}" current-id="{{pickerCurrentId}}" bind:select="onPickerSelect" bind:close="onPickerClose" />
</view>
