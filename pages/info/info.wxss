/** 书籍信息 **/
.page {
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
}
.tip {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #8A847A;
}

.form {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 28rpx;
}
.field {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #EEE9E0;
}
.field-column {
  flex-direction: column;
  align-items: stretch;
  padding: 28rpx 0;
  border-bottom: none;
}
.label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 30rpx;
}
.input {
  flex: 1;
  font-size: 30rpx;
}

.dates {
  flex: 1;
  display: flex;
  align-items: center;
}
.date {
  font-size: 30rpx;
  padding: 12rpx 0;
}
.placeholder {
  color: #B9B2A6;
}
.dash {
  margin: 0 20rpx;
  color: #8A847A;
}
.date-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 16rpx 0 20rpx 160rpx;
  font-size: 24rpx;
  color: #8A847A;
  border-bottom: 1rpx solid #EEE9E0;
}
.link {
  color: #B5835A;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 244, 239, 0.96);
}
.footer button {
  width: 100% !important;
  margin: 0 !important;
}
