<!-- 模板选择 -->
<view class="page">
  <view wx:if="{{mode === 'first'}}" class="tip">选一套风格作为整本书的主模板，之后可随时更换，也可以给单个跨页换风格</view>

  <view class="filters">
    <view class="filter {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilter">全部风格</view>
    <view class="filter {{filter === 'theme' ? 'active' : ''}}" data-filter="theme" bindtap="onFilter">按主题</view>
  </view>

  <view wx:if="{{filter === 'theme'}}" class="themes">
    <view wx:for="{{themes}}" wx:key="key" class="theme {{theme === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTheme">{{item.name}}</view>
  </view>

  <view wx:if="{{!visibleCards.length}}" class="empty">暂时没有适合这个主题的风格</view>

  <view wx:for="{{visibleCards}}" wx:key="id" class="card {{item.id === currentId ? 'current' : ''}}" data-id="{{item.id}}" bindtap="onSelect">
    <view class="preview">
      <image wx:if="{{item.preview}}" class="preview-img" src="{{item.preview}}" mode="aspectFit" />
      <view wx:else class="loading">生成示例中…</view>
    </view>
    <view class="card-main">
      <view class="card-title">
        <text class="name">{{item.name}}</text>
        <text wx:if="{{item.id === currentId}}" class="badge">当前</text>
      </view>
      <view wx:if="{{item.description}}" class="desc">{{item.description}}</view>
      <view wx:if="{{item.themesText}}" class="themes-text">适合：{{item.themesText}}</view>
    </view>
  </view>

  <view wx:if="{{mode === 'first'}}" class="footer">
    <button class="btn-secondary" bindtap="onSkip">跳过，使用纸白</button>
  </view>
</view>
