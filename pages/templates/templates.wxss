/** 模板选择 **/
.page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.tip {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8A847A;
}

.filters {
  display: flex;
  gap: 16rpx;
}
.filter {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #8A847A;
}
.filter.active {
  background: #2B2B2B;
  color: #FFFFFF;
}

.themes {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}
.theme {
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E3DDD2;
  background: #FFFFFF;
}
.theme.active {
  border-color: #B5835A;
  background: #B5835A;
  color: #FFFFFF;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #8A847A;
}

.card {
  margin-top: 28rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 4rpx solid transparent;
}
.card.current {
  border-color: #2F80ED;
}
/* 示例图 3:2 */
.preview {
  position: relative;
  width: 100%;
  padding-top: 66.67%;
  background: #F2EEE6;
  border-radius: 8rpx;
  overflow: hidden;
}
.preview-img,
.loading {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #B9B2A6;
}
.card-main {
  padding: 20rpx 8rpx 4rpx;
}
.card-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 600;
}
.badge {
  padding: 2rpx 14rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: #2F80ED;
  color: #FFFFFF;
}
.desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #2B2B2B;
}
.themes-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A847A;
}

/* 分组标题 */
.group-title {
  margin: 40rpx 0 -8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8A847A;
}

/* 纯色：色块小圆点 */
.swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 0;
  margin-top: 20rpx;
}
.swatch-wrap {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}
.swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.12);
}
.swatch.focus {
  box-shadow: 0 0 0 4rpx #FFFFFF, 0 0 0 8rpx #2B2B2B;
}
.swatch-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5A544C;
}
.solid-bottom {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.solid-info {
  flex: 1;
  min-width: 0;
}
.use-btn {
  padding: 14rpx 40rpx;
  font-size: 28rpx;
  border-radius: 999rpx;
  background: #2B2B2B;
  color: #FFFFFF;
}
