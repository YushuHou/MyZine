/** 模板选择 **/
.page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.tip {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-2);
}

.filters {
  display: flex;
  gap: 16rpx;
}
.filter {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  border-radius: var(--radius-btn);
  border: 2rpx solid var(--color-line);
  color: var(--color-text-2);
}
.filter.active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: var(--color-on-brand);
}

.themes {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}
.theme {
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  border-radius: var(--radius-btn);
  border: 2rpx solid var(--color-line);
  color: var(--color-text);
}
.theme.active {
  border-color: var(--color-brand);
  background: var(--color-brand);
  color: var(--color-on-brand);
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--color-text-2);
}

.card {
  margin-top: 28rpx;
  padding: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  border: 4rpx solid transparent;
}
/* 当前使用的模板：柯达黄边框 */
.card.current {
  border-color: var(--color-accent);
}
/* 示例图 3:2：放在深灰「桌面」上，书本缩进一圈并加投影 */
.preview {
  position: relative;
  width: 100%;
  padding-top: 66.67%;
  background: var(--color-desk);
  border-radius: 4rpx;
  overflow: hidden;
}
.preview-img {
  position: absolute;
  left: 5%;
  top: 5%;
  width: 90%;
  height: 90%;
  box-shadow: var(--shadow-book);
}
.loading {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-2);
}
.card-main {
  padding: 20rpx 8rpx 4rpx;
}
.card-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 600;
}
.badge {
  padding: 2rpx 14rpx;
  font-size: 22rpx;
  border-radius: var(--radius-btn);
  background: var(--color-accent);
  color: var(--color-on-accent);
}
.desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text);
}
.themes-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}

/* 分组标题 */
.group-title {
  margin: 40rpx 0 -8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-2);
}

/* 纯色：色块小圆点 */
.swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 0;
  margin-top: 20rpx;
}
.swatch-wrap {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}
.swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx var(--color-line);
}
.swatch.focus {
  box-shadow: 0 0 0 4rpx var(--color-surface), 0 0 0 8rpx var(--color-accent);
}
.swatch-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-2);
}
.solid-bottom {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.solid-info {
  flex: 1;
  min-width: 0;
}
.use-btn {
  padding: 14rpx 40rpx;
  font-size: 28rpx;
  border-radius: var(--radius-btn);
  background: var(--color-brand);
  color: var(--color-on-brand);
}
